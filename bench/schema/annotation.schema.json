{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kilickursat/GeoModel3D/bench/schema/annotation.schema.json",
  "title": "GeoModel3D benchmark ground truth",
  "description": "What one report shows, as read by a person from its pages. Version 1.0.0. Values are as printed, in the report's own units; every value names the page it was read from. See bench/guidelines/ANNOTATION.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "provenance",
    "scope",
    "documents",
    "pages",
    "boreholes",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "description": "draft: transcribed, not yet checked by a second person. verified: checked against the pages by a person other than the annotator, who signed it off in provenance.",
      "enum": [
        "draft",
        "verified"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotated_on",
        "annotator_kind",
        "method"
      ],
      "properties": {
        "annotated_on": {
          "$ref": "#/$defs/date"
        },
        "annotator_kind": {
          "enum": [
            "human",
            "assistant"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 10
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "verifier_kind": {
          "enum": [
            "human"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "boreholes",
        "fields"
      ],
      "properties": {
        "pages": {
          "description": "Pages whose type is annotated: all, or ranges per document.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pageRange"
              }
            }
          ]
        },
        "boreholes": {
          "enum": [
            "all",
            "sample"
          ]
        },
        "sample_rule": {
          "type": "string",
          "description": "How the sample was drawn, so it can be repeated (required when boreholes is sample)."
        },
        "fields": {
          "description": "Fields annotated for every borehole in scope. A field left out here is not scored.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "position",
              "ground_elevation",
              "final_depth",
              "layers",
              "spt",
              "rqd",
              "groundwater"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "boreholes": {
            "const": "sample"
          }
        }
      },
      "then": {
        "required": [
          "sample_rule"
        ]
      }
    },
    "documents": {
      "description": "The documents in the order supplied to the reader. Document numbers start at 0.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "pages",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "pages": {
      "description": "One entry per page in scope.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc",
          "page",
          "type"
        ],
        "properties": {
          "doc": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "$ref": "#/$defs/pageType"
          },
          "boreholes": {
            "description": "Borehole IDs whose log, core sheet or summary this page carries.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scan_quality": {
            "$ref": "#/$defs/scanQuality"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "boreholes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/borehole"
      }
    },
    "readiness": {
      "description": "Whether a 3-D ground model can be built from what the report itself shows, and if not, why. Abstaining is the right answer where the report lacks what a model needs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "reasons"
      ],
      "properties": {
        "expected": {
          "enum": [
            "spatial_model",
            "column_only",
            "abstain"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/readinessReason"
          }
        },
        "positioned_boreholes": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected": {
                "const": "abstain"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc",
        "from",
        "to"
      ],
      "properties": {
        "doc": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "description": "Where a value is printed: document and page (and optionally a box in PDF points, origin top left).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc",
        "page"
      ],
      "properties": {
        "doc": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "pageType": {
      "enum": [
        "borehole_log",
        "core_log",
        "core_photo",
        "borehole_summary",
        "site_plan",
        "cross_section",
        "lab_results",
        "insitu_test",
        "legend",
        "text",
        "front_matter",
        "drawing_other",
        "table_other",
        "blank",
        "other"
      ]
    },
    "scanQuality": {
      "enum": [
        "born_digital",
        "good_scan",
        "poor_scan",
        "handwritten"
      ]
    },
    "readinessReason": {
      "enum": [
        "no_logs",
        "no_positions",
        "too_few_positions",
        "local_coordinates_only",
        "unknown_crs",
        "single_borehole",
        "no_ground_elevation"
      ]
    },
    "lengthUnit": {
      "enum": [
        "m",
        "ft"
      ]
    },
    "principal": {
      "description": "The principal material of a layer, by its own description (the first soil or rock noun that names it).",
      "enum": [
        "made_ground",
        "topsoil",
        "peat_organic",
        "clay",
        "silt",
        "sand",
        "gravel",
        "cobbles_boulders",
        "rock",
        "volcanic_ash",
        "coal",
        "no_recovery",
        "other"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "as_printed": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "as_printed",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "latlon",
            "projected",
            "local",
            "station_offset"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "crs": {
          "type": "string",
          "description": "EPSG code (e.g. EPSG:6677) or a description where none applies; datum for lat/lon (e.g. JGD2011)."
        },
        "unit": {
          "$ref": "#/$defs/lengthUnit"
        },
        "as_printed": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "latlon"
              }
            }
          },
          "then": {
            "required": [
              "lat",
              "lon"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "projected",
                  "local",
                  "station_offset"
                ]
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y"
            ]
          }
        }
      ]
    },
    "borehole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pages",
        "depth_unit",
        "position",
        "ground_elevation",
        "final_depth",
        "layers",
        "spt",
        "rqd",
        "groundwater"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "As printed on the log."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other names the report gives the same hole (a plan's label, a summary table's)."
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          },
          "description": "Every page of the hole's log, core sheets included."
        },
        "kind": {
          "enum": [
            "borehole",
            "well",
            "trial_pit",
            "probe",
            "core_hole"
          ]
        },
        "depth_unit": {
          "$ref": "#/$defs/lengthUnit"
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ],
          "description": "null: the report gives none for this hole."
        },
        "ground_elevation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "datum": {
                  "type": "string"
                },
                "unit": {
                  "$ref": "#/$defs/lengthUnit"
                },
                "as_printed": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/$defs/source"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "final_depth": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "top",
              "base",
              "description",
              "principal",
              "source"
            ],
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0
              },
              "base": {
                "type": "number",
                "minimum": 0
              },
              "description": {
                "type": "string",
                "description": "As printed (it may be abridged with … where long)."
              },
              "principal": {
                "$ref": "#/$defs/principal"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "spt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "depth",
              "n",
              "source"
            ],
            "properties": {
              "depth": {
                "type": "number",
                "minimum": 0,
                "description": "Top of the test interval."
              },
              "n": {
                "type": "number",
                "minimum": 0,
                "description": "The N value as the log prints it in its N column. Where the column prints no number for a test (\">50\", or nothing), the blows counted."
              },
              "penetration_cm": {
                "type": "number",
                "minimum": 0
              },
              "refusal": {
                "type": "boolean"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "blows": {
                "type": "number",
                "minimum": 0,
                "description": "Blows counted, where the test stopped short of the full penetration (with penetration_cm)."
              }
            }
          }
        },
        "rqd": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "top",
              "base",
              "rqd",
              "source"
            ],
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0
              },
              "base": {
                "type": "number",
                "minimum": 0
              },
              "rqd": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "tcr": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "scr": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "groundwater": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "readings"
          ],
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_encountered",
                "not_recorded"
              ],
              "description": "recorded: a depth is printed. not_encountered: the log says no water was met. not_recorded: the log is silent."
            },
            "readings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "depth",
                  "kind",
                  "source"
                ],
                "properties": {
                  "depth": {
                    "type": "number"
                  },
                  "kind": {
                    "enum": [
                      "strike",
                      "standing",
                      "stabilised",
                      "unspecified"
                    ]
                  },
                  "date": {
                    "type": "string"
                  },
                  "source": {
                    "$ref": "#/$defs/source"
                  }
                }
              }
            }
          }
        },
        "note": {
          "type": "string"
        },
        "depth_resolution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Where depths are read from a drawn scale rather than printed as numbers: how closely they can be read, in depth_unit (for example 1 ft). The scorer accepts a depth within this distance."
        }
      }
    }
  }
}
