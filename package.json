    "stratigraphy",
    "cross-section",
    "subsurface",
    "groundwater",
    "effective-stress",
    "earth-pressure",
    "ags4",
    "bro",
    "dov",
    "gis",
    "coordinate-systems",
    "threejs",
    "webgpu",
    "engineering-geology"
  ],
  "homepage": "https://kilickursat.github.io/GeoModel3D/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilickursat/GeoModel3D.git"
  },
  "bugs": {
    "url": "https://github.com/kilickursat/GeoModel3D/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "proj4": "^2.22.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
